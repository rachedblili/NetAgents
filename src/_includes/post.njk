{% extends "base.njk" %}

{% block content %}
<section class="hero">
  <div class="wrap prose">
    <span class="eyebrow">Articles{% if "community" in tags %} &middot; Community{% endif %}</span>
    <h1>{{ heading }}</h1>
    <p class="lede">{{ summary }}</p>
    <p class="mono" style="color: var(--color-muted); font-size: 0.85rem; margin: 0;">{{ date | readableDate }}</p>
  </div>
</section>

<section>
  <div class="wrap prose">
    {% block article %}{% endblock %}
  </div>
</section>

<section class="section-alt">
  <div class="wrap prose">
    <h2>Discuss</h2>
    <p>Comments are hosted via <a href="https://giscus.app" rel="noopener">Giscus</a>, backed by <a href="https://github.com/rachedblili/NetAgents/discussions" rel="noopener">GitHub Discussions</a> on this repo &mdash; you need a GitHub account to post, not to read.</p>
    <script src="https://giscus.app/client.js"
      data-repo="rachedblili/NetAgents"
      data-repo-id="REPLACE_WITH_REPO_ID"
      data-category="Announcements"
      data-category-id="REPLACE_WITH_CATEGORY_ID"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang="en"
      crossorigin="anonymous"
      async>
    </script>
  </div>
</section>
{% endblock %}
